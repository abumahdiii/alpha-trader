# Copy to .env (gitignored) and fill in locally. NEVER commit .env or put real values here.
# See .claude/rules/03_trading_safety.md.

# Debug logging for the Python engine (Flutter passes its own DEV_MODE through when it launches the engine).
DEV_MODE=false

# Local engine API (127.0.0.1 only).
ENGINE_PORT=8765

# MetaTrader 5 — real account, READ-ONLY. Prefer the INVESTOR password (the broker then rejects any trade).
# Server: SarmayeGozareBartar-Real. Symbols use the .x variants (XAUUSD.x, BRNUSD.x).
MT5_TERMINAL_PATH=C:\Program Files\Sarmaye Gozare Bartar MT5 Terminal\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
